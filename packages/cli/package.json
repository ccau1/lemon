{
  "name": "@lemon/cli",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "bin": {
    "lemon": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "bundle:exe": "node scripts/bundle.js"
  },
  "pkg": {
    "scripts": [
      "dist/bundle.js"
    ],
    "assets": [
      "../../node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    ]
  },
  "dependencies": {
    "@lemon/server": "workspace:*",
    "@lemon/shared": "workspace:*",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@yao-pkg/pkg": "^6.4.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
